# ──────────────────────────────────────────────────────────────────────────────
# Lumina Capital — local development environment
#
# Copy this file to `.env` and fill in DB_PASSWORD before running the app.
# pydantic-settings reads `.env` automatically (src/core/config.py).
# ──────────────────────────────────────────────────────────────────────────────

# Application environment: "development" | "production"
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# When running via `docker compose up`, set DB_HOST=db (the service name).
# When running uvicorn against a host-side Postgres, use DB_HOST=localhost.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=assignment
DB_USER=postgres

# Sensitive — required. Held in pydantic.SecretStr so it never appears in logs.
DB_PASSWORD=replace-me
